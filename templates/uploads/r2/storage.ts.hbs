/**
 * Cloudflare R2 storage (S3-compatible). This is the only module that imports the AWS SDK;
 * the rest of the app calls the functions below. Server-only: never import it from client code.
 */
import { DeleteObjectCommand, GetObjectCommand, PutObjectCommand, S3Client } from '@aws-sdk/client-s3';
import { getSignedUrl } from '@aws-sdk/s3-request-presigner';

/** What the browser may upload. Enforced when signing: the URL only accepts this exact type and size. */
export const UPLOAD_RULES = {
  maxBytes: 5 * 1024 * 1024,
  contentTypes: {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
    'image/gif': 'gif',
  } as Record<string, string>,
  /** Seconds a presigned URL stays valid */
  urlTtl: 300,
};

/** A required env var is missing (thrown at request time, never at import time). */
export class StorageConfigError extends Error {
  override name = 'StorageConfigError';
}

/** The requested upload breaks UPLOAD_RULES (respond with 400). */
export class UploadRejectedError extends Error {
  override name = 'UploadRejectedError';
}

const REQUIRED_ENV = ['R2_ACCOUNT_ID', 'R2_ACCESS_KEY_ID', 'R2_SECRET_ACCESS_KEY', 'R2_BUCKET'] as const;

function readConfig() {
  const missing = REQUIRED_ENV.filter((key) => !process.env[key]);
  if (missing.length > 0) {
    throw new StorageConfigError(`File storage is not configured. Missing env vars: ${missing.join(', ')}`);
  }
  return {
    accountId: process.env.R2_ACCOUNT_ID!,
    accessKeyId: process.env.R2_ACCESS_KEY_ID!,
    secretAccessKey: process.env.R2_SECRET_ACCESS_KEY!,
    bucket: process.env.R2_BUCKET!,
    publicUrl: process.env.R2_PUBLIC_URL?.replace(/\/+$/, '') || undefined,
    // Override only to point at another S3-compatible server (e.g. MinIO in local dev)
    endpoint: process.env.R2_ENDPOINT || `https://${process.env.R2_ACCOUNT_ID}.r2.cloudflarestorage.com`,
  };
}

let cached: { client: S3Client; config: ReturnType<typeof readConfig> } | undefined;

function storage() {
  if (!cached) {
    const config = readConfig();
    const client = new S3Client({
      region: 'auto',
      endpoint: config.endpoint,
      credentials: { accessKeyId: config.accessKeyId, secretAccessKey: config.secretAccessKey },
      // Path-style URLs (endpoint/bucket/key) work for R2 and MinIO alike
      forcePathStyle: true,
      // Don't bake an (empty-body) CRC32 checksum into presigned PUT URLs; R2 would reject the real upload
      requestChecksumCalculation: 'WHEN_REQUIRED',
      responseChecksumValidation: 'WHEN_REQUIRED',
    });
    cached = { client, config };
  }
  return cached;
}

export function validateUpload(input: { contentType: unknown; size: unknown }) {
  const { contentType, size } = input;
  if (typeof contentType !== 'string' || !(contentType in UPLOAD_RULES.contentTypes)) {
    throw new UploadRejectedError(`File type not allowed. Allowed: ${Object.keys(UPLOAD_RULES.contentTypes).join(', ')}`);
  }
  if (typeof size !== 'number' || !Number.isInteger(size) || size <= 0) {
    throw new UploadRejectedError('File size must be a positive integer (bytes)');
  }
  if (size > UPLOAD_RULES.maxBytes) {
    throw new UploadRejectedError(`File too large. Max ${UPLOAD_RULES.maxBytes} bytes`);
  }
  return { contentType, size };
}

/**
 * Presigns a PUT the browser sends straight to R2. Content-Type and Content-Length are signed,
 * so the upload fails (403) if the browser sends a different type or a different number of bytes.
 */
export async function createUploadUrl(input: { contentType: unknown; size: unknown; prefix?: string }) {
  const { contentType, size } = validateUpload(input);
  const { client, config } = storage();
  const key = `${input.prefix ?? 'uploads'}/${crypto.randomUUID()}.${UPLOAD_RULES.contentTypes[contentType]}`;
  const uploadUrl = await getSignedUrl(
    client,
    new PutObjectCommand({ Bucket: config.bucket, Key: key, ContentType: contentType, ContentLength: size }),
    { expiresIn: UPLOAD_RULES.urlTtl, signableHeaders: new Set(['content-type', 'content-length']) },
  );
  return {
    key,
    uploadUrl,
    method: 'PUT' as const,
    // The browser must send exactly these headers (fetch sets Content-Length from the body itself)
    headers: { 'Content-Type': contentType },
    expiresIn: UPLOAD_RULES.urlTtl,
  };
}

/** Public URL when R2_PUBLIC_URL is set (public bucket / custom domain), otherwise a short-lived presigned GET. */
export async function getFileUrl(key: string, expiresIn = 3600) {
  const { client, config } = storage();
  if (config.publicUrl) return `${config.publicUrl}/${key.split('/').map(encodeURIComponent).join('/')}`;
  return getSignedUrl(client, new GetObjectCommand({ Bucket: config.bucket, Key: key }), { expiresIn });
}

export async function deleteFile(key: string) {
  const { client, config } = storage();
  await client.send(new DeleteObjectCommand({ Bucket: config.bucket, Key: key }));
}
