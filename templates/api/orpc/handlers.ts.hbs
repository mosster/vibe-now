import { OpenAPIHandler } from '@orpc/openapi/fetch';
import { OpenAPIReferencePlugin } from '@orpc/openapi/plugins';
import { onError } from '@orpc/server';
import { RPCHandler } from '@orpc/server/fetch';
import { ZodToJsonSchemaConverter } from '@orpc/zod/zod4';
import { router } from './router';

export const RPC_PREFIX = '/api/rpc';
export const OPENAPI_PREFIX = '/api/v1';

const rpcHandler = new RPCHandler(router, {
  interceptors: [onError((error) => console.error(error))],
});

// Serves REST endpoints, the OpenAPI spec at /api/v1/spec.json and API docs at /api/v1
const openAPIHandler = new OpenAPIHandler(router, {
  interceptors: [onError((error) => console.error(error))],
  plugins: [
    new OpenAPIReferencePlugin({
      schemaConverters: [new ZodToJsonSchemaConverter()],
      specGenerateOptions: {
        info: { title: '{{projectName}} API', version: '1.0.0' },
        servers: [{ url: OPENAPI_PREFIX }],
      },
    }),
  ],
});

export async function handleRPC(request: Request): Promise<Response> {
  const { response } = await rpcHandler.handle(request, { prefix: RPC_PREFIX, context: {} });
  return response ?? new Response('Not found', { status: 404 });
}

export async function handleOpenAPI(request: Request): Promise<Response> {
  const { response } = await openAPIHandler.handle(request, { prefix: OPENAPI_PREFIX, context: {} });
  return response ?? new Response('Not found', { status: 404 });
}
