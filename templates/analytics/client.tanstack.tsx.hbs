// Custom client entry (replaces TanStack Start's default one): starts {{#if isSentry}}Sentry{{/if}}{{#if isPostHog}}{{#if isSentry}} and {{/if}}PostHog{{/if}} in the browser, then hydrates.
// Analytics and error tracking start here: there can only be one src/client.tsx.
{{#if isSentry}}
import * as Sentry from '@sentry/tanstackstart-react';
{{/if}}
{{#if isPostHog}}
import posthog from 'posthog-js';
{{/if}}
import { StrictMode, startTransition } from 'react';
import { hydrateRoot{{#if isSentry}}, type ErrorInfo{{/if}} } from 'react-dom/client';
{{#if isSentry}}
import { isNotFound, isRedirect } from '@tanstack/react-router';
{{/if}}
import { StartClient } from '@tanstack/react-start/client';
{{#if isSentry}}

// Sentry error tracking. Without VITE_SENTRY_DSN the SDK sends nothing.
Sentry.init({
  dsn: import.meta.env.VITE_SENTRY_DSN,
  // Share of page loads traced; errors are always captured.
  tracesSampleRate: import.meta.env.DEV ? 1.0 : 0.1,
});

// Errors caught by error boundaries (incl. route errorComponents) never reach window.onerror;
// report them here. Router control flow (redirect/notFound) is not an error.
function reportCaughtError(error: unknown, errorInfo: ErrorInfo) {
  if (isRedirect(error) || isNotFound(error)) return;
  console.error(error);
  Sentry.captureReactException(error, errorInfo);
}
{{/if}}
{{#if isPostHog}}

// PostHog product analytics. Without VITE_POSTHOG_PROJECT_TOKEN nothing is initialized or sent.
const posthogToken = import.meta.env.VITE_POSTHOG_PROJECT_TOKEN;
if (posthogToken) {
  posthog.init(posthogToken, {
    api_host: import.meta.env.VITE_POSTHOG_HOST || 'https://us.i.posthog.com',
    // Pinned defaults (incl. SPA pageview + pageleave capture); bump deliberately
    defaults: '2026-08-30',
  });
}
{{/if}}

startTransition(() => {
  hydrateRoot(
    document,
    <StrictMode>
      <StartClient />
    </StrictMode>,
{{#if isSentry}}
    {
      onCaughtError: reportCaughtError,
      onUncaughtError: Sentry.reactErrorHandler(),
      onRecoverableError: Sentry.reactErrorHandler(),
    },
{{/if}}
  );
});
