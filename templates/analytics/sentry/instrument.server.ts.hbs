// Sentry for the server (SSR, server functions, server routes). Imported first by src/server.ts.
// Without VITE_SENTRY_DSN the SDK sends nothing.
import * as Sentry from '@sentry/tanstackstart-react';

Sentry.init({
  dsn: import.meta.env.VITE_SENTRY_DSN,
  tracesSampleRate: import.meta.env.DEV ? 1.0 : 0.1,
});
