// Runs in the browser before the app becomes interactive (auto-loaded by Next.js 15.3+).
// Analytics and error tracking start here: there can only be one instrumentation-client.ts.
{{#if isSentry}}
import * as Sentry from '@sentry/nextjs';
{{/if}}
{{#if isPostHog}}
import posthog from 'posthog-js';
{{/if}}
{{#if isSentry}}

// Sentry error tracking. Without NEXT_PUBLIC_SENTRY_DSN the SDK sends nothing.
Sentry.init({
  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN,
  // Share of page loads/navigations traced; errors are always captured.
  tracesSampleRate: process.env.NODE_ENV === 'development' ? 1.0 : 0.1,
});

// Traces App Router navigations.
export const onRouterTransitionStart = Sentry.captureRouterTransitionStart;
{{/if}}
{{#if isPostHog}}

// PostHog product analytics. Without NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN nothing is initialized or sent.
const posthogToken = process.env.NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN;
if (posthogToken) {
  const posthogHost = process.env.NEXT_PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';
  posthog.init(posthogToken, {
{{#if posthogProxy}}
    // Reverse proxy on this domain (rewrites in next.config.ts), so ad blockers drop fewer events
    api_host: '/ingest',
    ui_host: posthogHost.replace('.i.posthog.com', '.posthog.com'),
{{else}}
    api_host: posthogHost,
{{/if}}
    // Pinned defaults (incl. SPA pageview + pageleave capture); bump deliberately
    defaults: '2026-08-30',
  });
}
{{/if}}
